# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# Base de datos.
# Desarrollo: acceso administrativo temporal desde la Mac (puerto 33306).
# Producción: Jose configurará el host interno de Docker y un usuario con permisos mínimos.
DB_HOST=157.137.237.18
DB_PORT=33306
DB_NAME=Rode
DB_USER=
DB_PASSWORD=

# Servidor
PORT=3000
# development | production (en production la cookie de sesión exige HTTPS)
NODE_ENV=development

# Secreto para firmar los tokens. Cadena larga y aleatoria; no la compartas ni la subas.
JWT_SECRET=
