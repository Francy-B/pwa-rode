# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# Base de datos.


DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Servidor
PORT=
# development | production (en production la cookie de sesión exige HTTPS)
NODE_ENV=

# Secreto para firmar los tokens. Cadena larga y aleatoria; no la compartas ni la subas.
JWT_SECRET=
